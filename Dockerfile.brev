# ==============================================================================
# NVIDIA Brev Container Image (Dockerfile.brev)
# Project: BioKG — Autonomous Bio-Agent Knowledge Graph Workbench
# Author: Dr. Bheemaiah Anil Kumar, Synergy Robotics, Seattle
# ==============================================================================
FROM node:22-bookworm-slim

WORKDIR /workspace/biokg

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY package.json ./
RUN npm install

COPY . .
RUN npm run build

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000
ENV BIOKG_AGENT_RUNTIME=nemoclaw

CMD ["npm", "run", "start"]
